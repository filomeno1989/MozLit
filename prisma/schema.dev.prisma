generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url       = env("DATABASE_URL")

}

model User {
  id             String   @id @default(uuid())
  nome           String
  email          String?  @unique
  telefone       String?  @unique @map("telefone") // formato internacional: +258841234567
  senha_hash     String   // No default — must be set on creation
  role           String   @default("LEITOR") // ADMIN, ESCRITOR, LEITOR
  data_nascimento DateTime? @map("data_nascimento")
  saldo_carteira Float    @default(0) @map("saldo_carteira")
  moedas          Int      @default(0) @map("moedas")
  biografia      String   @default("")
  avatar_url     String   @default("") @map("avatar_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  books        Book[]
  transactions Transaction[]
  libraryItems LibraryItem[]
  comments     Comment[]
  recargas     RecargaSolicitacao[]

  @@map("profiles")
}

model Book {
  id             String   @id @default(uuid())
  titulo         String
  sinopse        String   @default("")
  capa_url       String   @default("/placeholder-cover.svg") @map("capa_url")
  preco_total    Float    @default(0) @map("preco_total")
  categoria      String   @default("Ficção") @map("categoria")
  categorias     String   @default("[]") @map("categorias")
  ficha_tecnica  String   @default("") @map("ficha_tecnica")
  dedicatoria    String   @default("") @map("dedicatoria")
  epigrafe       String   @default("") @map("epigrafe")
  epilogo        String   @default("") @map("epilogo")
  faixa_etaria   String   @default("Livre") @map("faixa_etaria")
  volume_info    Json?    @map("volume_info")
  status         String   @default("RASCUNHO")
  autorId        String   @map("autor_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  autor      User     @relation(fields: [autorId], references: [id], onDelete: Cascade)
  chapters   Chapter[]

  @@map("books")
}

model Chapter {
  id             String   @id @default(uuid())
  titulo         String
  conteudo       String   @default("")
  preco_capitulo Float    @default(0) @map("preco_capitulo")
  is_free        Boolean  @default(false) @map("is_free")
  ordem          Int      @default(0)
  livroId        String   @map("livro_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  livro          Book     @relation(fields: [livroId], references: [id], onDelete: Cascade)
  libraryItems   LibraryItem[]
  comments       Comment[]

  @@index([livroId, ordem])
  @@map("chapters")
}

model Transaction {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tipo       String
  valor      Float
  status     String   @default("PENDENTE")
  descricao  String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tipo])
  @@map("transactions")
}

model LibraryItem {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  bookId     String?  @map("book_id")
  chapterId  String?  @map("chapter_id")
  tipo       String   @default("CAPITULO")
  createdAt  DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId, bookId])
  @@index([userId, tipo])
  @@map("library_items")
}

model Comment {
  id         String   @id @default(uuid())
  conteudo   String
  chapterId  String   @map("chapter_id")
  userId     String   @map("user_id")
  parentId   String?  @map("parent_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@map("comments")
}

model RecargaSolicitacao {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  moedas        Int                       // quantidade de MC solicitada
  valorMzn      Float     @map("valor_mzn") // valor equivalente em MZN a pagar via M-Pesa
  metodo        String    @default("MPESA") // MPESA | EMOOLA | TRANSFERENCIA
  numeroEnvio   String?   @map("numero_envio") // número de onde foi feito o envio
  referencia    String?                   // ID / referência da transacção (comprovativo)
  nota          String?                   // observação opcional do usuário
  estado        String    @default("PENDENTE") // PENDENTE | APROVADA | REJEITADA | CANCELADA
  notaAdmin     String?   @map("nota_admin") // motivo da rejeição ou nota do admin
  processadaPor String?   @map("processada_por") // admin que processou
  processadaEm  DateTime? @map("processada_em")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, estado])
  @@index([estado, createdAt])
  @@map("recargas_solicitacoes")
}
