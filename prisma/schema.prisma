generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome           String
  email          String   @unique
  senha_hash     String   @default("")
  role           String   @default("LEITOR") // ADMIN, ESCRITOR, LEITOR
  saldo_carteira Float    @default(0) @map("saldo_carteira")
  biografia      String   @default("")
  avatar_url     String   @default("") @map("avatar_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  books        Book[]
  transactions Transaction[]
  libraryItems LibraryItem[]
  comments     Comment[]

  @@map("profiles")
}

model Book {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo         String
  sinopse        String   @default("")
  capa_url       String   @default("/placeholder-cover.svg") @map("capa_url")
  preco_total    Float    @default(0) @map("preco_total")
  categoria      String   @default("Ficção") @map("categoria")
  categorias     String   @default("[]") @map("categorias")
  ficha_tecnica  String   @default("") @map("ficha_tecnica")
  dedicatoria    String   @default("") @map("dedicatoria")
  epigrafe       String   @default("") @map("epigrafe")
  epilogo        String   @default("") @map("epilogo")
  status         String   @default("RASCUNHO")
  autorId        String   @map("autor_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  autor      User     @relation(fields: [autorId], references: [id], onDelete: Cascade)
  chapters   Chapter[]

  @@map("books")
}

model Chapter {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo         String
  conteudo       String   @default("")
  preco_capitulo Float    @default(0) @map("preco_capitulo")
  is_free        Boolean  @default(false) @map("is_free")
  ordem          Int      @default(0)
  livroId        String   @map("livro_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  livro          Book     @relation(fields: [livroId], references: [id], onDelete: Cascade)
  libraryItems   LibraryItem[]
  comments       Comment[]

  @@map("chapters")
}

model Transaction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tipo       String
  valor      Float
  status     String   @default("PENDENTE")
  descricao  String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model LibraryItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  bookId     String?  @map("book_id") @db.Uuid
  chapterId  String?  @map("chapter_id") @db.Uuid
  tipo       String   @default("CAPITULO")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@map("library_items")
}

model Comment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conteudo   String
  chapterId  String   @map("chapter_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  parentId   String?  @map("parent_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@map("comments")
}
