# MozLit - Variáveis de Ambiente

# JWT Secret para autenticação
JWT_SECRET=sua-chave-secreta-aqui

# Supabase - Conexão com a Base de Dados (PostgreSQL)
# Connection pooling (usada pelo Prisma em produção - via Supabase pooler)
DATABASE_URL=postgresql://postgres.jeyjzfpnersgfbavamsa:[SUA-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10

# Conexão directa (usada pelo Prisma para migrações - sem pooler)
DIRECT_URL=postgresql://postgres.jeyjzfpnersgfbavamsa:[SUA-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Supabase - Storage (para upload de capas)
NEXT_PUBLIC_SUPABASE_URL=https://jeyjzfpnersgfbavamsa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
