# MozLit - Variáveis de Ambiente

# JWT Secret para autenticação (mínimo 32 caracteres)
JWT_SECRET=sua-chave-secreta-aqui-minimo-32-caracteres

# Supabase - Conexão com a Base de Dados (PostgreSQL)
# Connection pooling (usada pelo Prisma em produção - via Supabase pooler)
DATABASE_URL=postgresql://postgres.SEU-PROJECT-ID:[SUA-PASSWORD]@aws-0-sua-regiao.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10

# Conexão directa (usada pelo Prisma para migrações - sem pooler)
DIRECT_URL=postgresql://postgres.SEU-PROJECT-ID:[SUA-PASSWORD]@aws-0-sua-regiao.pooler.supabase.com:5432/postgres

# Supabase - Storage (para upload de capas e avatares)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Recarga manual — contacto M-Pesa visível aos usuários na Carteira
NEXT_PUBLIC_ADMIN_MPESA=84 000 0000
NEXT_PUBLIC_ADMIN_MPESA_NOME=Nome do Titular MozLit

# Modo demonstração (true = permite depósitos simulados de saldo MZN)
NEXT_PUBLIC_DEMO_MODE=false

# Email do dono/administrador da plataforma (opcional, recomendado)
# Garante que este utilizador é sempre ADMIN na inicialização do servidor
# (protecção contra perda acidental do papel na base de dados)
ADMIN_EMAIL=teu-email@exemplo.com

# ID fixo do administrador (RECOMENDADO — mais seguro que ADMIN_EMAIL)
# Descubra o id do seu utilizador no Painel Admin → Utilizadores
# Se definido, tem prioridade sobre ADMIN_EMAIL no bootstrap
# ADMIN_USER_ID=uuid-do-utilizador-admin

# Apenas para scripts locais (nunca commitar valores reais):
# ADMIN_SENA_INICIAL=
# TESTE_ADMIN_EMAIL=
# TESTE_ADMIN_SENA=
