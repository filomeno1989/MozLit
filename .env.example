# MozLit - Variáveis de Ambiente

# JWT Secret para autenticação (mínimo 32 caracteres)
JWT_SECRET=sua-chave-secreta-aqui-minimo-32-caracteres

# Supabase - Conexão com a Base de Dados (PostgreSQL)
# Connection pooling (usada pelo Prisma em produção - via Supabase pooler)
DATABASE_URL=postgresql://postgres.SEU-PROJECT-ID:[SUA-PASSWORD]@aws-0-sua-regiao.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10

# Conexão directa (usada pelo Prisma para migrações - sem pooler)
DIRECT_URL=postgresql://postgres.SEU-PROJECT-ID:[SUA-PASSWORD]@aws-0-sua-regiao.pooler.supabase.com:5432/postgres

# Supabase - Storage (para upload de capas e avatares)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Modo demonstração (true = permite depósitos simulados)
NEXT_PUBLIC_DEMO_MODE=true