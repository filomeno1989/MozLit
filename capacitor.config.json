{
  "appId": "mz.mozlit.app",
  "appName": "MozLit",
  "webDir": "public",
  "server": {
    "url": "https://mozlit.vercel.app",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 4000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 300,
      "backgroundColor": "#EE941E",
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
